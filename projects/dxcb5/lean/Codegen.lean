-- Generates:
--   1. `projects/dxcb5/include/dxcb5/GeneratedOpcodeDesc.inc` from `OpcodeSpec.lean`
--   2. `projects/dxcb5/lib/Mir/Combine/GeneratedRules.inc` from `RewriteRules.lean`
import OpcodeSpec
import RewriteRules

open DXCB5.OpcodeSpec
open DXCB5.RewriteRules

def remapCpp : LaneRemapKind → String
  | .fixed => "Fixed"
  | .componentwise => "Componentwise"
  | .resourceReturnSwizzle => "ResourceReturnSwizzle"
  | .dotScalar => "DotScalar"

def slotRuleCpp : SourceSlotRule → String
  | .destMask => "DestMask"
  | .fixed2 => "Fixed2"
  | .fixed3 => "Fixed3"
  | .fixed4 => "Fixed4"
  | .scalar => "Scalar"
  | .src0Vec4 => "Src0Vec4"
  | .src01Vec4 => "Src01Vec4"
  | .src034Vec4 => "Src034Vec4"
  | .src0Vec4RestDest => "Src0Vec4RestDest"
  | .src0ScalarRestDest => "Src0ScalarRestDest"
  | .src01ScalarRestDest => "Src01ScalarRestDest"
  | .src0DestRestScalar => "Src0DestRestScalar"
  | .src0DestRest2 => "Src0DestRest2"
  | .perLaneScalar => "PerLaneScalar"

def slotRuleExprCpp : SourceSlotRule → String
  | .destMask => "Mask4"
  | .fixed2 => "0x3u"
  | .fixed3 => "0x7u"
  | .fixed4 => "0xfu"
  | .scalar => "0x1u"
  | .src0Vec4 => "SrcIndex == 0 ? 0xfu : 0x1u"
  | .src01Vec4 => "(SrcIndex == 0 || SrcIndex == 1) ? 0xfu : 0x1u"
  | .src034Vec4 => "(SrcIndex == 0 || SrcIndex == 3 || SrcIndex == 4) ? 0xfu : 0x1u"
  | .src0Vec4RestDest => "SrcIndex == 0 ? 0xfu : Mask4"
  | .src0ScalarRestDest => "SrcIndex == 0 ? 0x1u : Mask4"
  | .src01ScalarRestDest => "(SrcIndex == 0 || SrcIndex == 1) ? 0x1u : Mask4"
  | .src0DestRestScalar => "SrcIndex == 0 ? Mask4 : 0x1u"
  | .src0DestRest2 => "SrcIndex == 0 ? Mask4 : 0x3u"
  | .perLaneScalar => "(SrcIndex < 4 && (Mask4 & (1u << SrcIndex))) ? 0x1u : 0x0u"

def renderSlotRuleCase (r : SourceSlotRule) : String :=
  s!"DXCB5_SLOT_RULE_CASE({slotRuleCpp r}, {slotRuleExprCpp r})"

def flagMask (d : OpcodeDesc) : Nat :=
  (if d.isCompare then 1 <<< 0 else 0) +
  (if d.isCommutativeBinary then 1 <<< 1 else 0) +
  (if d.isDerivative then 1 <<< 2 else 0) +
  (if d.requiresQuad then 1 <<< 3 else 0) +
  (if d.isComponentwise then 1 <<< 4 else 0) +
  (if d.acceptsFloatMods then 1 <<< 5 else 0) +
  (if d.acceptsIntNeg then 1 <<< 6 else 0) +
  (if d.supportsSaturate then 1 <<< 7 else 0) +
  (if d.canEliminateIfDead then 1 <<< 8 else 0) +
  (if d.canMoveAcrossDivergentBranch then 1 <<< 9 else 0) +
  (if d.canMoveAcrossUniformBranch then 1 <<< 10 else 0) +
  (if d.isControlOp then 1 <<< 11 else 0) +
  (if d.isPostRaPureEliminable then 1 <<< 12 else 0)

def renderOpcodeEntry (op : Sm5Opcode) : String :=
  let d := desc op
  let macroName := if op.isPseudo then "DXCB5_PSEUDO_OPCODE" else "DXCB5_SM5_OPCODE"
  s!"{macroName}({op.cppName}, {d.numDests}u, {flagMask d}u, {remapCpp d.laneRemap}, {slotRuleCpp d.slotRule})"

def renderOpcodeHeader : String :=
  let header := [
    "// Distributed under the University of Illinois Open Source License.",
    "// AUTO-GENERATED by projects/dxcb5/lean/Codegen.lean from OpcodeSpec.lean.",
    "// Do not edit by hand; regenerate via `lake exe dxcb5-codegen --opcodes <out>`.",
    "",
    "#ifdef DXCB5_SM5_OPCODE"
  ]
  let sm5Body := (Sm5Opcode.all.filter (fun op => !op.isPseudo)).map renderOpcodeEntry
  let mid1 := ["#endif", "", "#ifdef DXCB5_PSEUDO_OPCODE"]
  let pseudoBody := (Sm5Opcode.all.filter (fun op => op.isPseudo)).map renderOpcodeEntry
  let mid2 := ["#endif", "", "#ifdef DXCB5_SLOT_RULE_CASE"]
  let slotCases := SourceSlotRule.all.map renderSlotRuleCase
  let tail := ["#endif"]
  String.intercalate "\n" (header ++ sm5Body ++ mid1 ++ pseudoBody ++ mid2 ++ slotCases ++ tail) ++ "\n"

def modeReqCpp : ModeReq → String
  | .always => "Always"
  | .notPrecise => "NotPrecise"
  | .notPreciseNotNanSafe => "NotPreciseNotNanSafe"
  | .notPreciseAndNonNaNF => "NotPreciseAndNonNaNF"

def actionCpp : LocalRuleAction → String
  | .movOtherSide => "MovOtherSide"
  | .movConstImm => "MovConstImm"
  | .unaryOpOtherSide => "UnaryOpOtherSide"

def hexU32 (v : UInt32) : String :=
  let digits := "0123456789abcdef".toList
  let rec go (n : Nat) (acc : List Char) : List Char :=
    match n with
    | 0 => acc
    | k + 1 =>
      let nib := ((v.toNat >>> (4 * k)) &&& 0xf)
      let ch := digits[nib]?.getD '0'
      go k (acc ++ [ch])
  "0x" ++ String.ofList (go 8 []) ++ "u"

theorem hexU32_non_palindrome :
    hexU32 0x12345678 = "0x12345678u" ∧
    hexU32 0x00000001 = "0x00000001u" ∧
    hexU32 0x80000000 = "0x80000000u" := by
  decide

def renderInvCmp (r : InvCmpRule) : String :=
  s!"DXCB5_INV_CMP_RULE({r.srcOp.cppName}, {r.invOp.cppName}, {modeReqCpp r.req})"

def renderMovcMinMax (r : MovcMinMaxRule) : String :=
  let flt := if r.isFloat then "true" else "false"
  s!"DXCB5_MOVC_MINMAX_RULE({r.cmpOp.cppName}, {r.directOp.cppName}, {r.swappedOp.cppName}, {flt}, {modeReqCpp r.req})"

def renderBinaryImm (r : BinaryImmRule) : String :=
  s!"DXCB5_BINARY_IMM_RULE({r.opcode.cppName}, {hexU32 r.matchImm}, {actionCpp r.action}, {r.outOp.cppName}, {hexU32 r.outImm}, {modeReqCpp r.req})"

def renderRulesHeader : String :=
  let header := [
    "// Distributed under the University of Illinois Open Source License.",
    "// AUTO-GENERATED by projects/dxcb5/lean/Codegen.lean from RewriteRules.lean.",
    "// Do not edit by hand; regenerate via `lake exe dxcb5-codegen --rules <out>`.",
    "",
    "#ifdef DXCB5_INV_CMP_RULE"
  ]
  let invBody := invCmpRules.map renderInvCmp
  let mid1 := ["#endif", "", "#ifdef DXCB5_MOVC_MINMAX_RULE"]
  let mmBody := movcMinMaxRules.map renderMovcMinMax
  let mid2 := ["#endif", "", "#ifdef DXCB5_BINARY_IMM_RULE"]
  let binBody := binaryImmRules.map renderBinaryImm
  let tail := ["#endif"]
  String.intercalate "\n" (header ++ invBody ++ mid1 ++ mmBody ++ mid2 ++ binBody ++ tail) ++ "\n"

def main (args : List String) : IO UInt32 := do
  match args with
  | ["--opcodes", outPath] =>
    IO.FS.writeFile outPath renderOpcodeHeader
    return 0
  | ["--rules", outPath] =>
    IO.FS.writeFile outPath renderRulesHeader
    return 0
  | _ =>
    IO.eprintln "Usage: dxcb5-codegen [--opcodes|--rules] <output-path>"
    return 2
